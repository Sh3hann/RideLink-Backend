{
  "openapi": "3.0.1",
  "info": {
    "title": "RideLink Account & Access Service",
    "description": "Microservice 1 (Member 1): Passenger/driver registration, JWT login, profile management, and account status.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local Account Service"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new passenger or driver account",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Email already exists or validation error"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/accounts/{id}": {
      "get": {
        "summary": "Get user profile by ID",
        "operationId": "getProfileById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "fullName", "phoneNumber", "role"],
        "properties": {
          "email": {"type": "string", "format": "email", "example": "passenger.alice@example.com"},
          "password": {"type": "string", "example": "SecurePass123!"},
          "fullName": {"type": "string", "example": "Alice Senanayake"},
          "phoneNumber": {"type": "string", "example": "+94771234567"},
          "role": {"type": "string", "enum": ["PASSENGER", "DRIVER", "ADMIN"], "example": "PASSENGER"}
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {"type": "string", "format": "email", "example": "passenger.alice@example.com"},
          "password": {"type": "string", "example": "SecurePass123!"}
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {"type": "string"},
          "tokenType": {"type": "string", "example": "Bearer"},
          "id": {"type": "string"},
          "email": {"type": "string"},
          "fullName": {"type": "string"},
          "role": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    }
  }
}

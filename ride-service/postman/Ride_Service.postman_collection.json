    {
      "name": "1. Happy Path — End-to-End Ride Lifecycle",
      "item": [
        {
          "name": "1.1 Create Ride Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Ride ID generated and estimated fare calculated', function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.estimatedFare).to.be.above(0);",
                  "    pm.environment.set('rideId', jsonData.id);",
                  "    if (jsonData.driverId) {",
                  "        pm.environment.set('driverId', jsonData.driverId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"{{passengerId}}\",\n  \"pickupLocation\": \"Colombo Fort Railway Station\",\n  \"destinationLocation\": \"Galle Face Green, Colombo 03\",\n  \"serviceArea\": \"COLOMBO_CENTRAL\",\n  \"vehicleClass\": \"CAR_SEDAN\",\n  \"distanceKm\": 5.8,\n  \"estimatedDurationMin\": 16.5,\n  \"notes\": \"Near the main ticketing counter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "request"]
            }
          }
        },
        {
          "name": "1.2 Get Ride Details by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Ride details match requested ride', function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('rideId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId}}"]
            }
          }
        },
        {
          "name": "1.3 Driver Accepts Ride (ASSIGNED -> ACCEPTED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Ride status is ACCEPTED', function () {",
                  "    pm.expect(jsonData.status).to.eql('ACCEPTED');",
                  "    pm.expect(jsonData.acceptedAt).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/accept?driverId={{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "accept"],
              "query": [
                { "key": "driverId", "value": "{{driverId}}" }
              ]
            }
          }
        },
        {
          "name": "1.4 Driver Starts Ride (ACCEPTED -> IN_PROGRESS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Ride status is IN_PROGRESS', function () {",
                  "    pm.expect(jsonData.status).to.eql('IN_PROGRESS');",
                  "    pm.expect(jsonData.startedAt).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/start?driverId={{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "start"],
              "query": [
                { "key": "driverId", "value": "{{driverId}}" }
              ]
            }
          }
        },
        {
          "name": "1.5 Driver Completes Ride (IN_PROGRESS -> COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Ride status is COMPLETED and final fare recorded', function () {",
                  "    pm.expect(jsonData.status).to.eql('COMPLETED');",
                  "    pm.expect(jsonData.finalFare).to.be.above(0);",
                  "    pm.expect(jsonData.completedAt).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/complete?driverId={{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "complete"],
              "query": [
                { "key": "driverId", "value": "{{driverId}}" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "3. Assignment & Cancellation Workflows",
      "item": [
        {
          "name": "Create Ride for Manual Assignment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('rideId2', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"usr_pass_202\",\n  \"pickupLocation\": \"Bambalapitiya Junction\",\n  \"destinationLocation\": \"Majestic City, Colombo 04\",\n  \"serviceArea\": \"COLOMBO_CENTRAL\",\n  \"vehicleClass\": \"TUK\",\n  \"distanceKm\": 2.3,\n  \"estimatedDurationMin\": 8.0,\n  \"notes\": \"Waiting near bus stand\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides"]
            }
          }
        },
        {
          "name": "Assign Driver to Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Status updated to ASSIGNED with driver', function () {",
                  "    pm.expect(json.status).to.eql('ASSIGNED');",
                  "    pm.expect(json.driverId).to.eql('drv_manual_99');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"drv_manual_99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId2}}/assign-driver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId2}}", "assign-driver"]
            }
          }
        },
        {
          "name": "Cancel Ride with Reason",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Ride cancelled and reason recorded', function () {",
                  "    pm.expect(json.status).to.eql('CANCELLED');",
                  "    pm.expect(json.cancellationReason).to.eql('Rider had to reschedule');",
                  "    pm.expect(json.cancelledBy).to.eql('PASSENGER');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Rider had to reschedule\",\n  \"cancelledBy\": \"PASSENGER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId2}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId2}}", "cancel"]
            }
          }
        },

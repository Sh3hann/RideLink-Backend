    {
      "name": "4. Negative Scenarios & Error Handling",
      "item": [
        {
          "name": "Negative 1: Invalid State Transition (COMPLETED -> CANCELLED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Error response details state machine violation', function () {",
                  "    pm.expect(json.status).to.eql(400);",
                  "    pm.expect(json.message).to.include('Invalid ride status transition');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Cannot cancel finished trip\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "{{rideId}}", "cancel"]
            }
          }
        },
        {
          "name": "Negative 2: Ride Not Found (404 Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Error message identifies missing resource', function () {",
                  "    pm.expect(json.status).to.eql(404);",
                  "    pm.expect(json.message).to.include('Ride not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides/non_existing_ride_id_999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides", "non_existing_ride_id_999"]
            }
          }
        },
        {
          "name": "Negative 3: Validation Error — Invalid Input Payload (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Validation errors map contains constraint violations', function () {",
                  "    pm.expect(json.status).to.eql(400);",
                  "    pm.expect(json.error).to.eql('Validation Failed');",
                  "    pm.expect(json.validationErrors).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"\",\n  \"pickupLocation\": \"\",\n  \"destinationLocation\": \"\",\n  \"serviceArea\": \"\",\n  \"vehicleClass\": \"\",\n  \"distanceKm\": -5.0,\n  \"estimatedDurationMin\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rides",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rides"]
            }
          }
        }
      ]
